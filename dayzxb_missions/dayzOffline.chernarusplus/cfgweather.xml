<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Ambiance BROUILLARD : brouillard épais en permanence, ciel gris, pas de pluie, vent faible. -->
<!-- Préréglage de meteo/brouillard/ : à copier sur cfgweather.xml (à la racine de la mission), voir README. -->
<!-- Sur Chernarus le script du jeu choisit toujours la météo ; ce fichier ne fait que borner les valeurs (limits). -->
<!-- reset="1" : on ignore la météo sauvegardée pour appliquer l'ambiance dès le redémarrage. -->
<weather reset="1" enable="1">
    <overcast>
        <!-- Couverture nuageuse (0 = ciel dégagé, 1 = ciel noir) -->
        <current actual="0.6" time="60" duration="600" />
        <limits min="0.45" max="0.8" />
        <timelimits min="600" max="900" />
        <changelimits min="0.0" max="1.0" />
    </overcast>
    <fog>
        <!-- Brouillard (0..1). Le script de Chernarus tire une valeur de 0 à 0.15 (0.35 certains matins)
             toutes les 15 à 30 min ; le minimum la remonte : le brouillard ne se lève jamais.
             C'est le réglage principal de l'ambiance : baisser min/max si on n'y voit vraiment rien. -->
        <current actual="1.0" time="60" duration="900" />
        <!-- 0.6 à 0.85 : visibilité mesurée à 260 m au télémètre (trop clair). On est maintenant au maximum. -->
        <limits min="0.9" max="1.0" />
        <timelimits min="900" max="1800" />
        <changelimits min="0.0" max="1.0" />
    </fog>
    <rain>
        <!-- Pluie coupée : le brouillard seul. -->
        <current actual="0.0" time="60" duration="120" />
        <limits min="0.0" max="0.0" />
        <timelimits min="60" max="120" />
        <changelimits min="0.0" max="1.0" />
        <thresholds min="0.6" max="1.0" end="60" />
    </rain>
    <windMagnitude>
        <!-- Vent en m/s : air presque immobile. Le script de Chernarus tire 4 à 17 m/s à chaque changement de nuages ;
             le maximum à 4 n'est peut-être pas respecté (le jeu remet sa limite à 20), à vérifier en jeu. -->
        <current actual="2.0" time="60" duration="600" />
        <limits min="0.0" max="4.0" />
        <timelimits min="120" max="240" />
        <changelimits min="0.0" max="20.0" />
    </windMagnitude>
    <windDirection>
        <current actual="0.0" time="120" duration="240" />
        <limits min="-3.14" max="3.14" />
        <timelimits min="60" max="120" />
        <changelimits min="-1.0" max="1.0" />
    </windDirection>
    <!-- Neige : toujours bloquée à 0 par le script de Chernarus, inutile de la modifier. -->
    <snowfall>
        <current actual="0.0" time="0" duration="32768" />
        <limits min="0.0" max="0.0" />
        <timelimits min="300" max="3600" />
        <changelimits min="0.0" max="0.0" />
        <thresholds min="1.0" max="1.0" end="120" />
    </snowfall>
    <!-- Éclairs : le jeu impose un seuil de couverture à 0.9 (jamais atteint ici). -->
    <storm density="1.0" threshold="0.9" timeout="45"/>
</weather>
